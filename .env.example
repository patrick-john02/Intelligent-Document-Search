HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intelligent_document_search
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intelligent_document_search


DOCUMENT_PATH=./documents/
CORS_ORIGINS=http://localhost:3000

# Auth / session
ACCESS_TOKEN_EXPIRE_MINUTES=15
IDLE_TIMEOUT_MINUTES=60          # auto-logout after 1 hour without keyboard/mouse activity
ABSOLUTE_SESSION_HOURS=12        # must log in again after this, even if active
REFRESH_COOKIE_SECURE=false      # set true when served over HTTPS
REFRESH_COOKIE_SAMESITE=lax      # frontend and API must share a site (e.g. both "localhost")

OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TOKENIZER=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
LLM_MODEL=qwen2.5:3b
VISION_LLM=qwen2-vl:7b

OLLAMA_API_KEY="your-api-key"
TAVILY_API_KEY="your-tavily-api-key"

LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="api-key-of-langsmith"
LANGCHAIN_PROJECT="name-of-the-project"





SECRET_KEY = "meow_meow"
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 30